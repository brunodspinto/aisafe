@startuml US005-SSD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

title US005 - Automated Deployment Scripts (SSD)

autonumber

actor "Developer/PM" as Dev
participant ":System\n(Unix Shell)" as Shell

activate Dev

    Dev -> Shell : executes script (e.g. ./build.sh)
    activate Shell

        Shell --> Dev : displays build/execution progress
    deactivate Shell

    Dev -> Shell : executes ./run_backoffice.sh
    activate Shell

        Shell --> Dev : starts backoffice application
    deactivate Shell

    Dev -> Shell : executes ./run_tests.sh
    activate Shell

        Shell --> Dev : runs tests and displays coverage report path
    deactivate Shell

    Dev -> Shell : executes ./db_setup.sh [profile]
    activate Shell

        Shell --> Dev : sets up database for given profile
    deactivate Shell

deactivate Dev

@enduml
