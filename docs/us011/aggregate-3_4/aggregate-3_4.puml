  @startuml
skinparam shadowing false
skinparam classAttributeIconSize 0

title Domain Model


package "User Aggregate" <<Rectangle>> {

    class User <<entity, aggregate root>> {
        name
        phoneNumber
        position
        status
        skillsAssessmentDate
    }

    class Email <<value object>> {
        address
    }

    class EmailDomain <<value object>> {
        domain
    }

    class SecurityClearance <<value object>> {
        level
        expirationDate
    }

    class Role <<value object>> {
    }
}


package "AirTransportCompany Aggregate" <<Rectangle>> {

    class AirTransportCompany <<entity, aggregate root>> {
        name
        IATACode
        ICAOCode
    }
}


package "Maker Aggregate" <<Rectangle>> {

    class Maker <<entity, aggregate root>> {
        name
        country
    }
}


package "EngineModel Aggregate" <<Rectangle>> {

    class EngineModel <<entity, aggregate root>> {
        name
        thrustAtStandstill
        thrustAtCruiseSpeed
        TSFC
    }
}


package "AircraftModel Aggregate" <<Rectangle>> {

    class AircraftModel <<entity, aggregate root>> {
        modelName
        emptyWeight
        MTOW
        MZFW
        maxFuelCapacity
        serviceCeiling
        cruiseSpeed
        wingSpan
        wingArea
        dragCoefficient
        liftCoefficient
    }
}


package "Aircraft Aggregate" <<Rectangle>> {

    class Aircraft <<entity, aggregate root>> {
        registrationNumber
        registrationCountry
        numberOfCrewElements
    }

    class CabinConfiguration <<value object>> {
        firstClassSeats
        businessClassSeats
        economyClassSeats
    }
}


package "AirControlArea Aggregate" <<Rectangle>> {

    class AirControlArea <<entity, aggregate root>> {
        areaCode
        name
        minimumFuelRequired
    }

    class GeoBoundary <<value object>> {
        northLatitude
        southLatitude
        eastLongitude
        westLongitude
    }
}


package "Airport Aggregate" <<Rectangle>> {

    class Airport <<entity, aggregate root>> {
        name
        town
        country
        IATACode
        ICAOCode
        altitude
        latitude
        longitude
    }
}


package "FlightRoute Aggregate" <<Rectangle>> {

    class FlightRoute <<entity, aggregate root>> {
        name
        status
        activeUntil
    }
}


package "Flight Aggregate" <<Rectangle>> {

    class Flight <<entity, aggregate root>> {
        departureDateTime
        scheduledArrival
    }
}


package "FlightPlan Aggregate" <<Rectangle>> {

    class FlightPlan <<entity, aggregate root>> {
        totalFuelLoad
        cargoWeight
    }

    class FlightSegment <<entity>> {
        allowedAltitudeSlots
        widthPerAltitudeSlot
        windDirection
        windSpeed
    }

    class Node <<value object>> {
        latitude
        longitude
        altitude
    }
}


package "WeatherData Aggregate" <<Rectangle>> {

    class WeatherData <<entity, aggregate root>> {
        date
        windSpeed
        windDirection
        temperature
        pressure
        visibility
    }

    class WeatherSource <<value object>> {
        provider
        format
    }
}


package "Simulation Aggregate" <<Rectangle>> {

    class Simulation <<entity, aggregate root>> {
        timeRangeStart
        timeRangeEnd
        timeStep
        safetyThreshold
        status
    }

    class SimulationReport <<entity>> {
        totalFlights
        passed
        generatedAt
    }

    class SafetyViolation <<entity>> {
        timestamp
        speed
        heading
        latitude
        longitude
        altitude
    }
}


class AirportCode <<value object>> {
    code
}

class FlightPlanId <<value object>> {
    id
}


Enum RoleType {
    ADMIN
    BACKOFFICE_OPERATOR
    ATCC
    PILOT
    FLIGHT_CONTROL_OPERATOR
    WEATHER_PERSON
}

Enum AircraftType {
    PASSENGER
    CARGO
    MIXED
}

Enum EngineType {
    TURBOPROP
    TURBOFAN
    TURBOJET
    RAMJET
    ELECTRIC_PROPELLER
}

Enum OperationalStatus {
    ACTIVE
    DECOMMISSIONED
}

Enum FlightPlanStatus {
    DRAFT
    VALIDATED
    APPROVED
    REJECTED
}

Enum FlightType {
    REGULAR
    CHARTER
}

Enum FlightRouteStatus {
    ACTIVE
    INACTIVE
}


User "1" *-- "1" Email : "identified by"
Email "1" *-- "1" EmailDomain : "belongs to"
User "1" *-- "1" SecurityClearance : "holds"
User "1" *-- "1" Role : "has"
Role "1" --> "1" RoleType : "typed as"


AirTransportCompany "1" --> "0..*" User : "employs"
AirTransportCompany "1" --> "0..*" Aircraft : "owns"
AirTransportCompany "1" --> "0..*" FlightRoute : "operates"
User "0..*" --> "0..*" AircraftModel : "certified for"

Maker "1" --> "0..*" AircraftModel : "manufactures"
Maker "1" --> "0..*" EngineModel : "manufactures"

AircraftModel "1" --> "1" AircraftType : "classified as"
AircraftModel "1" --> "1..*" EngineModel : "certified with"
EngineModel "1" --> "1" EngineType : "classified as"

Aircraft "1" *-- "1" CabinConfiguration : "has"
Aircraft "1" --> "1" AircraftModel : "defined by"
Aircraft "1" --> "1" OperationalStatus : "has"

Airport "0..*" --> "1" AirControlArea : "belongs to"
AirControlArea "1" *-- "1" GeoBoundary : "bounded by"

FlightRoute "1" --> "1" AirportCode : "originates at"
FlightRoute "1" --> "1" AirportCode : "ends at"
FlightRoute "1" --> "1" FlightRouteStatus : "has"
FlightRoute "1" --> "0..*" Flight : "has"

Flight "1" --> "0..*" FlightPlan : "has"
Flight "1" --> "1" FlightType : "typed as"


FlightPlan "1" --> "1" Aircraft : "uses"
FlightPlan "1" --> "1" User : "assigned to"
FlightPlan "1" --> "1" FlightPlanStatus : "has"
FlightPlan "1" *-- "1..*" FlightSegment : "composed of"
FlightPlan "0..1" --> "1" WeatherData : "uses"

FlightSegment "1" *-- "1" Node : "starts at"
FlightSegment "1" *-- "1" Node : "ends at"

WeatherData "1" --> "1" AirControlArea : "recorded for"
WeatherData "1" *-- "1" WeatherSource : "imported from"

Simulation "1" --> "1" AirControlArea : "covers"
Simulation "1" --> "0..*" FlightPlan : "includes"
Simulation "1" *-- "1" SimulationReport : "produces"
SimulationReport "1" *-- "0..*" SafetyViolation : "records"
SafetyViolation "0..*" --> "1" FlightPlanId : "references"

@enduml