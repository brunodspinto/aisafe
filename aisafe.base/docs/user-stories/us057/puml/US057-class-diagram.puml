@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

title US057 - Class Diagram (Compact)

package "Presentation" {
    class AddEngineToAircraftModelUI {
        # doShow() : boolean
    }
}

package "Application" {
    class AddEngineToAircraftModelController {
        + allAircraftModels() : Iterable<AircraftModel>
        + allEngineModels() : Iterable<EngineModel>
        + addEngine(aircraft: AircraftModel, engine: EngineModel) : AircraftModel
    }
}

package "Domain" {
    class AircraftModel <<entity>> <<aggregate root>> {
        - modelName : String
        - version : Long <<@Version>>
        - certifiedEngines : List<EngineModel>
        + addEngine(engine: EngineModel) : void
    }

    class EngineModel <<entity>> <<aggregate root>> {
        - name : String
        - makerName : String
        - engineType : EngineType
        + identity() : Long
    }
}

package "eapli.framework.infrastructure.authz" {
    class AuthorizationService {
        + ensureAuthenticatedUserHasAnyOf(roles: RoleType...)
    }
}

package "Persistence" {
    interface AircraftModelRepository <<repository>> {
        + save(entity: AircraftModel) : AircraftModel
        + findAll() : Iterable<AircraftModel>
    }

    interface EngineModelRepository <<repository>> {
        + findAll() : Iterable<EngineModel>
    }

    class JpaAircraftModelRepository {
        + save(entity: AircraftModel) : AircraftModel
        + findAll() : Iterable<AircraftModel>
    }

    class JpaEngineModelRepository {
        + findAll() : Iterable<EngineModel>
    }
}

AddEngineToAircraftModelUI .down.> AddEngineToAircraftModelController
AddEngineToAircraftModelController .down.> AuthorizationService
AddEngineToAircraftModelController .down.> AircraftModel
AddEngineToAircraftModelController .down.> EngineModel
AddEngineToAircraftModelController .down.> AircraftModelRepository
AddEngineToAircraftModelController .down.> EngineModelRepository

note right of AircraftModel: Maintains a @ManyToMany List<EngineModel>\nand a @Version for Optimistic Locking
AircraftModel "1" --> "1..*" EngineModel : "certifiedEngines >"


AircraftModelRepository "1" --> "*" AircraftModel : "stores >"
EngineModelRepository "1" --> "*" EngineModel : "stores >"

JpaAircraftModelRepository .up.|> AircraftModelRepository
JpaEngineModelRepository .up.|> EngineModelRepository

@enduml