@startuml domain_model_us081
skinparam shadowing false
skinparam classAttributeIconSize 0

package "FlightPlan Aggregate" <<Rectangle>> {
    class FlightPlan <<entity, aggregate root>> {
        flightType : String
        status : FlightPlanStatus
        dslContent : String
    }

    class FlightPlanDesignator <<value object, EmbeddedId>> {
        value : String
    }

    enum FlightPlanStatus {
        DRAFT
        VALIDATED
        TESTED
    }
}

package "DSL AST (transient)" <<Rectangle>> {
    class FlightPlanAst <<record>> {
        identifier : String
        flightType : FlightType
    }

    class LegAst <<record>> {
    }

    class SegmentAst <<record>> {
        altitudeMeters : double
        widthMeters : double
        windSpeed : double
        windDirection : double
    }

    class CoordinateAst <<record>> {
        latitude : double
        longitude : double
    }

    class EndpointAst <<record>> {
        airportCode : String
        date : String
        time : String
    }

    class RouteAst <<record>> {
        fromAirportCode : String
        toAirportCode : String
    }

    class FuelAst <<record>> {
        amount : double
        unit : String
    }

    enum FlightType {
        REGULAR
        CHARTER
    }
}

FlightPlan "1" --> "1" FlightPlanDesignator : identified by
FlightPlan "1" --> "1" FlightPlanStatus : has

FlightPlanAst "1" *-- "1..*" LegAst : contains
FlightPlanAst "1" --> "1" FlightType
LegAst "1" *-- "1..*" SegmentAst : contains
LegAst "1" --> "1" EndpointAst : departure
LegAst "1" --> "1" EndpointAst : arrival
LegAst "1" --> "1" RouteAst
LegAst "1" --> "1" FuelAst
SegmentAst "1" --> "2" CoordinateAst : from / to

FlightPlanAst ..> FlightPlan : <<creates via fromDsl()>>

@enduml
