@startuml US105-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

title US105 - Hybrid Simulation: shared-memory lock-step (SD)

autonumber
actor "Flight Control Operator" as OP
participant "main\n(parent)" as MAIN
participant "coordinator_thread" as COORD
participant "report_thread" as REPORT
participant "shm:sim_shm_t\n(shared memory)" as SHM
participant "flight child i\n(process)" as CHILD

activate OP
OP -> MAIN : ./flight_simulator
activate MAIN

MAIN -> SHM : shm_create()\n(shm_unlink + shm_open O_EXCL + ftruncate + mmap)
MAIN -> MAIN : open pos/ctrl semaphores (value 0)
MAIN -> CHILD ** : fork() one process per flight
MAIN -> COORD ** : pthread_create(coordinator_thread)
MAIN -> REPORT ** : pthread_create(report_thread)

loop each simulation step
    CHILD -> SHM : write positions[i]
    CHILD -> COORD : sem_post(pos_sems[i])
    activate COORD
    COORD -> SHM : read positions[i]
    COORD -> COORD : ACA filter + safety-cylinder check
    COORD -> SHM : write ctrl[i] (GO/STOP)
    COORD -> CHILD : sem_post(ctrl_sems[i])
    deactivate COORD
    CHILD -> CHILD : sem_wait(ctrl_sems[i]); advance or exit
end

COORD -> SHM : write total_violations, sim_aborted
COORD -> REPORT : pthread_cond_signal(g_done_cond)
activate REPORT
REPORT -> SHM : read final results
REPORT --> OP : final report
deactivate REPORT

MAIN -> MAIN : join threads; cleanup\n(munmap, shm_unlink, sem_close/unlink)
deactivate MAIN
deactivate OP

@enduml
