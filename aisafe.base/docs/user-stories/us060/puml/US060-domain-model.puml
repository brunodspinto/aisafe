@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0

title Domain Model — AirTransportCompany Aggregate

package "AirTransportCompany Aggregate" <<Rectangle>> {

    class AirTransportCompany <<entity, aggregate root>> {
        name : String
    }
}

class IATACode <<value object>> {
    code : String
}

note right of IATACode
  Company IATA: exactly 2
  uppercase letters (e.g. "TP")
end note

class ICAOCode <<value object>> {
    code : String
}

note right of ICAOCode
  Company ICAO: 2 or 3
  uppercase letters (e.g. "TAP")
end note

package "Aircraft Aggregate" <<Rectangle>> {
    class Aircraft <<entity, aggregate root>>
}

AirTransportCompany "1" --> "1" IATACode : "identified by"
AirTransportCompany "1" --> "1" ICAOCode : "identified by"

AirTransportCompany "1" ..> "0..*" Aircraft : "fleet\n(by registrationNumber: String)"

note bottom of AirTransportCompany
  Fleet stored as Set<String>
  (registration numbers)
end note

@enduml
