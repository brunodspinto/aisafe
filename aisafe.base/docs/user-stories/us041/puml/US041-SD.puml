@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber
actor "Weather Person" as WP

participant ":RegisterWeatherDataUI" as UI
participant ":RegisterWeatherDataController" as CTRL
participant "authz\n:AuthorizationService" as AUTHZ
participant "areaRepo\n:AirControlAreaRepository" as AREAREPO
participant "source\n:WeatherSource" as WSOURCE
participant "newWeatherData\n:WeatherData" as WDATA
participant "weatherRepo\n:WeatherDataRepository" as WREPO

activate WP
WP -> UI : requests to register weather data
activate UI

' UI asks the controller for available areas
UI -> CTRL** : create()
UI -> CTRL : activeAirControlAreas()
activate CTRL

' Security (NFR09) - Validate role
CTRL -> AUTHZ : ensureAuthenticatedUserHasAnyOf(RoleType.WEATHER_PERSON)
activate AUTHZ
AUTHZ --> CTRL : (ok)
deactivate AUTHZ

CTRL -> AREAREPO : findAll()
activate AREAREPO
AREAREPO --> CTRL : areaList
deactivate AREAREPO

CTRL --> UI : areaList
deactivate CTRL

UI --> WP : displays available Air Control Areas and requests input data\n(area selection, provider, format, date, temperature,\nwind speed, wind direction, pressure, visibility)
deactivate UI

WP -> UI : selects area and inputs required data
activate UI

UI -> CTRL : registerWeatherData(areaCode, provider, format, date,\ntemperature, windSpeed, windDirection, pressure, visibility)
activate CTRL

' Value Object creation and validation
CTRL -> WSOURCE** : create(provider, format)
note right of WSOURCE: Value Object validates provider and format automatically

' Aggregate Root creation
CTRL -> WDATA** : create(areaCode, source, date, temperature,\nwindSpeed, windDirection, pressure, visibility)
note right of WDATA: areaCode is kept as an external reference (low coupling)

' Persistence
CTRL -> WREPO : save(newWeatherData)
activate WREPO
WREPO --> CTRL : savedWeatherData
deactivate WREPO

CTRL --> UI : savedWeatherData
deactivate CTRL

UI --> WP : displays success message
deactivate UI
deactivate WP

@enduml