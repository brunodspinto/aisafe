@startuml US073_SequenceDiagram

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title Sequence Diagram - US073 Create a Flight Route

actor "ATCC\n(Air Transport Company\nCollaborator)" as atcc
participant "CreateFlightRouteUI" as ui
participant "CreateFlightRouteController" as ctrl
participant "AuthorizationService" as authz
participant "AirportRepository" as airportRepo
participant "AirTransportCompanyRepository" as companyRepo
participant "FlightRouteRepository" as routeRepo
participant "FlightRoute" as route

atcc -> ui : show()
activate ui

ui -> ui : readRouteName()\nreadOriginCode()\nreadDestinationCode()

ui -> ctrl : createFlightRoute(routeName, originCode, destinationCode)
activate ctrl

ctrl -> authz : ensureAuthenticatedUserHasAnyOf(ATCC)
activate authz
authz --> ctrl : ok
deactivate authz

ctrl -> companyRepo : findByCollaborator(authenticatedUser)
activate companyRepo
companyRepo --> ctrl : company
deactivate companyRepo

ctrl -> airportRepo : ofIdentity(originCode)
activate airportRepo
airportRepo --> ctrl : Optional<Airport> [present]
deactivate airportRepo

ctrl -> airportRepo : ofIdentity(destinationCode)
activate airportRepo
airportRepo --> ctrl : Optional<Airport> [present]
deactivate airportRepo

note over ctrl : originCode != destinationCode\n(AC073.2)

ctrl -> routeRepo : existsByName(routeName)
activate routeRepo
routeRepo --> ctrl : false
deactivate routeRepo

ctrl -> route ** : new FlightRoute(routeName, originCode, destinationCode, company)
activate route
note right of route : Status = ACTIVE\n(invariant enforced\nin constructor)
route --> ctrl : flightRoute
deactivate route

ctrl -> routeRepo : save(flightRoute)
activate routeRepo
routeRepo --> ctrl : savedRoute
deactivate routeRepo

ctrl --> ui : savedRoute
deactivate ctrl

ui --> atcc : "Flight route 'TP123' (OPO → LIS) created successfully."
deactivate ui

@enduml
