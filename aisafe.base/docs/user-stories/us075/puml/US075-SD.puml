@startuml US075_SequenceDiagram

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title Sequence Diagram - US075 Add a Pilot

actor "ATCC" as atcc
participant "AddPilotUI" as ui
participant "AddPilotController" as ctrl
participant "AuthorizationService\n(EAPLI)" as authz
participant "CollaboratorRepository" as collabRepo
participant "AirTransportCompanyRepository" as companyRepo
participant "AircraftModelRepository" as modelRepo
participant "UserManagementService\n(EAPLI)" as userSvc
participant "UserRepository" as userRepo
participant "PilotRepository" as pilotRepo
participant "Pilot" as pilot

atcc -> ui : addPilot(username, password, firstName,\nlastName, email, phoneNumber,\nposition, clearance, certifications)
activate ui

ui -> ctrl : addPilot(...)
activate ctrl

ctrl -> authz : ensureAuthenticatedUserHasAnyOf(ATCC)
activate authz
authz --> ctrl : ok
deactivate authz

ctrl -> collabRepo : findBySystemUser(authenticatedUser)
activate collabRepo
collabRepo --> ctrl : collaborator
deactivate collabRepo

ctrl -> companyRepo : ofIdentity(companyIataCode)
activate companyRepo
companyRepo --> ctrl : company
deactivate companyRepo

loop for each certifiedAircraftModelId
    ctrl -> modelRepo : ofIdentity(modelId)
    activate modelRepo
    modelRepo --> ctrl : aircraftModel
    deactivate modelRepo
end

ctrl -> userSvc : registerNewUser(username, password,\nfirstName, lastName, email, PILOT)
activate userSvc
userSvc --> ctrl : systemUser
deactivate userSvc

ctrl -> userRepo : save(new User(systemUser, mecNumber, ...))
activate userRepo
userRepo --> ctrl : savedUser
deactivate userRepo

ctrl -> pilot ** : new Pilot(user, companyIataCode, certifications)
activate pilot
pilot --> ctrl : pilot
deactivate pilot

ctrl -> pilotRepo : save(pilot)
activate pilotRepo
pilotRepo --> ctrl : savedPilot
deactivate pilotRepo

ctrl --> ui : savedPilot
deactivate ctrl

ui --> atcc : "Pilot successfully added!"
deactivate ui

@enduml
