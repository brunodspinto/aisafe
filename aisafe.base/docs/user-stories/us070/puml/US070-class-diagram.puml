@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

title US070 - Class Diagram (Add Aircraft to Fleet)

package "Presentation" {
    class AddAircraftUI {
        # doShow() : boolean
    }
}

package "Application" {
    class AddAircraftController {
        + allAircraftModels() : Iterable<AircraftModel>
        + addAircraft(model: AircraftModel, registration: String, country: String, crew: int, year: int, first: int, business: int, economy: int) : AirTransportCompany
    }
}

package "Domain" {
    class AirTransportCompany <<entity>> <<aggregate root>> {
        - name : String
        - version : Long <<@Version>>
        - fleet : Set<String>
        + addAircraftToFleet(aircraft: Aircraft) : void
        + fleet() : Set<String>
    }

    class RegistrationNumber <<value object, identity>> {
        - code : String
        + {static} valueOf(code : String) : RegistrationNumber
        + toString() : String
    }

    class Aircraft <<entity>> <<aggregate root>> {
        - registrationNumber : RegistrationNumber <<@EmbeddedId>>
        - registeredCountry : String
        - numberOfCrewElements : int
        - yearOfManufacture : int
        - operationalStatus : OperationalStatus
        + Aircraft(registration, country, crew, year, cabin, model)
        + identity() : RegistrationNumber
        + decommission() : void
        + isActive() : boolean
    }

    class CabinConfiguration <<value object>> <<@Embeddable>> {
        - firstClassSeats : int
        - businessClassSeats : int
        - economyClassSeats : int
        + CabinConfiguration(first, business, economy)
        + totalSeats() : int
    }

    class AircraftModel <<entity>> <<aggregate root>> {
        - modelName : String
        - maxCapacity : int
        + maxCapacity() : int
    }

    enum OperationalStatus {
        ACTIVE
        DECOMMISSIONED
    }
}

package "eapli.framework.infrastructure.authz" {
    class AuthorizationService {
        + ensureAuthenticatedUserHasAnyOf(roles: RoleType...)
        + session() : UserSession
    }

    class SystemUser {
    }
}

package "Persistence" {
    interface AircraftRepository <<repository>> {
        + save(entity: Aircraft) : Aircraft
    }

    interface AirTransportCompanyRepository <<repository>> {
        + save(entity: AirTransportCompany) : AirTransportCompany
    }

    interface AircraftModelRepository <<repository>> {
        + findAll() : Iterable<AircraftModel>
    }

    interface CollaboratorRepository <<repository>> {
        + findBySystemUser(user: SystemUser) : Optional<Collaborator>
    }

    class JpaAircraftRepository { }
    class JpaAirTransportCompanyRepository { }
    class JpaAircraftModelRepository { }
    class JpaCollaboratorRepository { }
}

AddAircraftUI .down.> AddAircraftController
AddAircraftController .down.> AirTransportCompany
AddAircraftController .down.> Aircraft
AddAircraftController .down.> CabinConfiguration
AddAircraftController .down.> AircraftModel
AddAircraftController .down.> AirTransportCompanyRepository
AddAircraftController .down.> AircraftRepository
AddAircraftController .down.> AircraftModelRepository
AddAircraftController .down.> CollaboratorRepository
AddAircraftController .down.> AuthorizationService

Aircraft "1" *-- "1" RegistrationNumber : "identified by >"
Aircraft "1" *-- "1" CabinConfiguration : "has (Embedded) >"
Aircraft "1" --> "1" OperationalStatus : "has >"
Aircraft "1" --> "1" AircraftModel : "defined by >"

AirTransportCompany "1" ..> "*" Aircraft : "fleet\n(by registrationNumber: String)"

' Persistence Implementations (Dependency Inversion)
JpaAircraftRepository .up.|> AircraftRepository
JpaAirTransportCompanyRepository .up.|> AirTransportCompanyRepository
JpaAircraftModelRepository .up.|> AircraftModelRepository
JpaCollaboratorRepository .up.|> CollaboratorRepository

@enduml
