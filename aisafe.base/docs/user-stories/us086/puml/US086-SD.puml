@startuml sd086
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Pilot" as PILOT

box "Client Application" #EBF5FB
    participant ":PilotTcpClientApp" as APP
    participant ":PilotTcpClient" as CLIENT
end box

participant "TCP" as TCP

box "Server Application" #FEF9E7
    participant ":TcpClientDispatcher" as DISP
    participant ":PilotSessionHandler" as HANDLER
    participant ":CreateFlightPlanFromFileController" as CTRL
    participant ":InsertWeatherDataController" as CTRL2
    participant ":TestFlightPlanController" as CTRL3
    participant ":FlightPlanRepository" as REPO
    participant ":WeatherDataRepository" as WREPO
end box

participant "AuthenticationContext" as AUTH

activate PILOT

PILOT -> APP : run client application
activate APP
APP -> CLIENT** : new PilotTcpClient(host, port)
activate CLIENT
CLIENT --> APP
deactivate CLIENT
APP --> PILOT : requests credentials
PILOT -> APP : enters username and password
APP -> CLIENT : login(username, password)
activate CLIENT
CLIENT -> TCP : LOGIN <username> <password>
activate TCP
TCP -> DISP : read line
activate DISP
DISP -> AUTH : authenticate(username, password)
activate AUTH
AUTH --> DISP : authenticated
deactivate AUTH

alt invalid credentials
    DISP -> TCP : FAIL invalid credentials
    TCP --> CLIENT : FAIL ...
    CLIENT --> APP : false
    APP --> PILOT : authentication failed
else role != PILOT
    DISP -> TCP : UNAUTHORIZED
    TCP --> CLIENT : UNAUTHORIZED
    CLIENT --> APP : false
    APP --> PILOT : unauthorized
else authenticated with PILOT role
    DISP -> HANDLER** : new PilotSessionHandler(reader, writer)
    DISP -> TCP : OK
    deactivate TCP
    TCP --> CLIENT : OK
    deactivate CLIENT
    APP --> PILOT : authenticated — shows menu
    deactivate APP

    PILOT -> APP : selects "Create Flight Plan from DSL File"
    activate APP
    APP --> PILOT : requests DSL file path
    PILOT -> APP : enters file path
    APP -> CLIENT : createFlightPlanFromFile(filePath)
    activate CLIENT
    CLIENT -> CLIENT : reads DSL file → byteLength
    CLIENT -> TCP : CREATE_FLIGHT_PLAN <byteLength>\n<dsl_content>
    activate TCP
    TCP -> HANDLER : read command + DSL bytes
    activate HANDLER
    HANDLER -> HANDLER : Files.createTempFile() + write DSL bytes
    HANDLER -> CTRL** : new CreateFlightPlanFromFileController()
    activate CTRL
    CTRL --> HANDLER
    deactivate CTRL
    HANDLER -> CTRL : createFromFile(tempPath)
    activate CTRL
    CTRL -> REPO : save(flightPlan)
    activate REPO
    REPO --> CTRL : savedFlightPlan
    deactivate REPO
    CTRL --> HANDLER : savedFlightPlan
    deactivate CTRL
    HANDLER -> HANDLER : Files.delete(tempPath)
    HANDLER -> TCP : OK <designator>
    deactivate HANDLER
    TCP --> CLIENT : OK <designator>
    deactivate TCP
    CLIENT --> APP : designator
    deactivate CLIENT
    APP --> PILOT : displays success + designator
    deactivate APP

    PILOT -> APP : selects "Insert Weather Data"
    activate APP
    APP -> CLIENT : listMyPlans()
    activate CLIENT
    CLIENT -> TCP : LIST_MY_PLANS
    activate TCP
    TCP -> HANDLER : LIST_MY_PLANS
    activate HANDLER
    HANDLER -> CTRL2** : new InsertWeatherDataController()
    HANDLER -> CTRL2 : myFlightPlans()
    activate CTRL2
    CTRL2 -> REPO : findAll() [filtered by pilot]
    activate REPO
    REPO --> CTRL2 : plans
    deactivate REPO
    CTRL2 --> HANDLER : plans
    deactivate CTRL2
    HANDLER -> TCP : OK <count>\n<designator status>...
    deactivate HANDLER
    TCP --> CLIENT : OK <count> + lines
    deactivate TCP
    CLIENT --> APP : List<String>
    deactivate CLIENT
    APP -> CLIENT : listWeatherData()
    activate CLIENT
    CLIENT -> TCP : LIST_WEATHER_DATA
    activate TCP
    TCP -> HANDLER : LIST_WEATHER_DATA
    activate HANDLER
    HANDLER -> CTRL2 : availableWeatherData()
    activate CTRL2
    CTRL2 -> WREPO : findAll()
    activate WREPO
    WREPO --> CTRL2 : weatherData
    deactivate WREPO
    CTRL2 --> HANDLER : weatherData
    deactivate CTRL2
    HANDLER -> TCP : OK <count>\n<id areaCode date>...
    deactivate HANDLER
    TCP --> CLIENT : OK <count> + lines
    deactivate TCP
    CLIENT --> APP : List<String>
    deactivate CLIENT
    APP --> PILOT : displays plans and weather data
    PILOT -> APP : enters designator + weather data id
    APP -> CLIENT : insertWeatherData(designator, id)
    activate CLIENT
    CLIENT -> TCP : INSERT_WEATHER_DATA <designator> <id>
    activate TCP
    TCP -> HANDLER : INSERT_WEATHER_DATA <designator> <id>
    activate HANDLER
    HANDLER -> CTRL2 : insertWeatherData(designator, id)
    activate CTRL2
    CTRL2 -> REPO : ofIdentity(designator)
    activate REPO
    REPO --> CTRL2 : plan
    deactivate REPO
    CTRL2 -> WREPO : ofIdentity(id)
    activate WREPO
    WREPO --> CTRL2 : weatherData
    deactivate WREPO
    CTRL2 -> REPO : save(plan)
    activate REPO
    REPO --> CTRL2 : savedPlan
    deactivate REPO
    CTRL2 --> HANDLER : savedPlan
    deactivate CTRL2
    HANDLER -> TCP : OK <designator>
    deactivate HANDLER
    TCP --> CLIENT : OK <designator>
    deactivate TCP
    CLIENT --> APP : response
    deactivate CLIENT
    APP --> PILOT : weather data inserted
    deactivate APP

    PILOT -> APP : selects "Test Flight Plan"
    activate APP
    APP -> CLIENT : testFlightPlan(designator)
    activate CLIENT
    CLIENT -> TCP : TEST_FLIGHT_PLAN <designator>
    activate TCP
    TCP -> HANDLER : TEST_FLIGHT_PLAN <designator>
    activate HANDLER
    HANDLER -> CTRL3** : new TestFlightPlanController()
    HANDLER -> CTRL3 : testFlightPlan(designator)
    activate CTRL3
    CTRL3 -> REPO : ofIdentity(designator)
    activate REPO
    REPO --> CTRL3 : plan
    deactivate REPO
    note right of CTRL3 : re-parse DSL → serialize to JSON\n→ invoke C binary → read result
    CTRL3 -> REPO : save(plan) [status TESTED]
    activate REPO
    REPO --> CTRL3 : savedPlan
    deactivate REPO
    CTRL3 --> HANDLER : savedPlan
    deactivate CTRL3
    HANDLER -> TCP : OK <designator>
    deactivate HANDLER
    TCP --> CLIENT : OK <designator>
    deactivate TCP
    CLIENT --> APP : response
    deactivate CLIENT
    APP --> PILOT : flight plan tested successfully
    deactivate APP

    PILOT -> APP : selects "Exit"
    activate APP
    APP -> CLIENT : exit()
    activate CLIENT
    CLIENT -> TCP : EXIT
    activate TCP
    TCP -> HANDLER : read line (EXIT)
    HANDLER -> TCP : BYE
    deactivate HANDLER
    deactivate DISP
    TCP --> CLIENT : BYE
    deactivate TCP
    deactivate CLIENT
    APP --> PILOT : session ended
    deactivate APP
end

deactivate PILOT

@enduml
