@startuml class-diagram-us086
skinparam shadowing false
skinparam classAttributeIconSize 0

package "Client Application" {
    class PilotTcpClientApp {
        +main(args : String[]) : void
        -showMenu() : void
    }

    class PilotTcpClient {
        -socket : Socket
        -in : BufferedReader
        -out : PrintWriter
        +PilotTcpClient(host : String, port : int)
        +login(username : String, password : String) : boolean
        +createFlightPlanFromFile(filePath : String) : String
        +insertWeatherData(designator : String, weatherDataId : long) : String
        +testFlightPlan(designator : String) : String
        +listMyPlans() : List<String>
        +listWeatherData() : List<String>
        +exit() : void
        +close() : void
    }
}

package "Server Application" {
    class AiSafeTcpServer {
        -serverSocket : ServerSocket
        +start(port : int) : void
    }

    class TcpClientDispatcher {
        -clientSocket : Socket
        +TcpClientDispatcher(socket : Socket)
        +run() : void
        -authenticate(reader : BufferedReader, writer : PrintWriter) : boolean
        -resolveRole() : String
    }

    class PilotSessionHandler {
        -in : BufferedReader
        -out : PrintWriter
        +PilotSessionHandler(in : BufferedReader, out : PrintWriter)
        +handle() : void
        -handleCreateFlightPlan() : void
        -handleInsertWeatherData() : void
        -handleTestFlightPlan() : void
        -handleListMyPlans() : void
        -handleListWeatherData() : void
    }
}

package "Application Layer" {
    class CreateFlightPlanFromFileController <<UseCaseController>> {
        -authz : AuthorizationService
        -repository : FlightPlanRepository
        -parser : FlightPlanParserFacade
        +createFromFile(filePath : String) : FlightPlan
    }

    class InsertWeatherDataController <<UseCaseController>> {
        -authz : AuthorizationService
        -pilotRepo : PilotRepository
        -flightPlanRepo : FlightPlanRepository
        -weatherDataRepo : WeatherDataRepository
        +myFlightPlans() : Iterable<FlightPlan>
        +availableWeatherData() : Iterable<WeatherData>
        +insertWeatherData(designator : String, weatherDataId : Long) : FlightPlan
    }

    class TestFlightPlanController <<UseCaseController>> {
        -authz : AuthorizationService
        -repository : FlightPlanRepository
        -parser : FlightPlanParserFacade
        -binaryPath : String
        +validatedDslPlans() : Iterable<FlightPlan>
        +testFlightPlan(designator : String) : FlightPlan
    }
}

package "Domain Layer" {
    class FlightPlan <<entity>> {
        +identity() : FlightPlanDesignator
        +status() : FlightPlanStatus
        +addWeatherData(id : Long) : void
        +markTested() : void
    }

    class FlightPlanDesignator <<value object>> {
        +valueOf(id : String) : FlightPlanDesignator
        +toString() : String
    }

    class WeatherData <<entity>> {
        +identity() : Long
        +areaCode() : String
        +date() : LocalDateTime
    }
}

package "Repository Layer" {
    interface FlightPlanRepository {
        +save(plan : FlightPlan) : FlightPlan
        +ofIdentity(id : FlightPlanDesignator) : Optional<FlightPlan>
        +findAllValidated() : Iterable<FlightPlan>
    }

    interface WeatherDataRepository {
        +ofIdentity(id : Long) : Optional<WeatherData>
        +findAll() : Iterable<WeatherData>
    }
}

package "EAPLI Framework" <<frame>> {
    class AuthenticationContext {
        +authenticate(username : String, password : String) : boolean
        +hasRole(role : Role) : boolean
        +clear() : void
    }

    class AuthorizationService
}

package "Infrastructure" {
    class AiSafeRoles {
        {static} PILOT : Role
    }
}

PilotTcpClientApp ..> PilotTcpClient : uses
AiSafeTcpServer ..> TcpClientDispatcher : spawns
TcpClientDispatcher ..> AuthenticationContext : authenticates via
TcpClientDispatcher ..> AiSafeRoles : checks PILOT role
TcpClientDispatcher ..> PilotSessionHandler : delegates to
PilotSessionHandler ..> CreateFlightPlanFromFileController : creates & calls
PilotSessionHandler ..> InsertWeatherDataController : creates & calls
PilotSessionHandler ..> TestFlightPlanController : creates & calls
CreateFlightPlanFromFileController ..> AuthorizationService : checks role
CreateFlightPlanFromFileController ..> FlightPlanRepository : saves
InsertWeatherDataController ..> AuthorizationService : checks role
InsertWeatherDataController ..> FlightPlanRepository : saves
InsertWeatherDataController ..> WeatherDataRepository : queries
TestFlightPlanController ..> AuthorizationService : checks role
TestFlightPlanController ..> FlightPlanRepository : saves
FlightPlan *-- FlightPlanDesignator : identity
FlightPlanRepository ..> FlightPlan : manages
WeatherDataRepository ..> WeatherData : manages

@enduml
