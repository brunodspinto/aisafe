@startuml US110-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

title US110 - Wind publication and lateral drift (SD)

autonumber
participant "coordinator_thread" as COORD
participant "environment_thread" as ENV
participant "weather_service" as WS
participant "shm.environment\n(guarded by /aisafe_env, value 1)" as SHM
participant "flight child i\n(process)" as CHILD

loop each simulation step
    COORD -> ENV : tick (pthread_cond_signal env_cond)
    activate ENV
    ENV -> WS : weather_service_fetch()\n(reads AISAFE_WIND, calm 0,0 if unset)
    WS --> ENV : environment_t {wind_speed, wind_direction}
    ENV -> SHM : sem_wait(/aisafe_env);\nwrite environment + env_step;\nsem_post(/aisafe_env)
    deactivate ENV

    CHILD -> SHM : sem_wait(/aisafe_env);\nread environment; sem_post(/aisafe_env)
    activate CHILD
    alt wind_speed > 0
        CHILD -> CHILD : apply_wind_drift_values(&lat,&lon,...)\n(modifies lat/lon ONLY)
    else calm
        CHILD -> CHILD : apply_wind_drift(seg)  // per-segment fallback
    end
    CHILD -> SHM : write drifted positions[i]\n(flows into US102/US107 safety pipeline)
    deactivate CHILD
end

@enduml
