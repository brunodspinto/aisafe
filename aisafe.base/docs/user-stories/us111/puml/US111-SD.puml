@startuml sd111
skinparam packageStyle rectangle
skinparam shadowing false
autonumber

actor "Flight Control\nOperator" as FCO

participant ":GenerateSimulationReportUI" as UI
participant ":GenerateSimulationReportController" as CTRL
participant "authz : AuthorizationService" as AUTH
participant "resultsReader :\nTextSimulationResultsReader" as READER
participant "simulation : Simulation" as SIM
participant "formatter :\nOperationalReportFormatter" as FMT
participant "writer : ReportWriter" as WRITER

activate FCO
FCO -> UI : selects "Generate Simulation Report"
activate UI
UI -> CTRL : generate()
activate CTRL

CTRL -> AUTH : ensureAuthenticatedUserHasAnyOf(FLIGHT_CONTROL_OPERATOR)
activate AUTH
AUTH --> CTRL : authorized
deactivate AUTH

CTRL -> CTRL : resolveOperatorArea(fco)

CTRL -> READER : read(reportSource)
activate READER
READER --> CTRL : results (totalFlights, statuses, violations)
deactivate READER

CTRL -> SIM : buildReport(results)
activate SIM
SIM -> SIM : passed = (COMPLETED && no violations)
SIM --> CTRL : report
deactivate SIM

CTRL -> CTRL : toReportData(report, area, fco)

CTRL -> FMT : format(reportData)
activate FMT
FMT --> CTRL : content
deactivate FMT

CTRL -> WRITER : write(fileName, content)
activate WRITER
WRITER --> CTRL : file
deactivate WRITER

CTRL --> UI : GeneratedReport(file, report)
deactivate CTRL
UI --> FCO : file path + PASSED/FAILED + flight/violation counts
deactivate UI
deactivate FCO

@enduml
