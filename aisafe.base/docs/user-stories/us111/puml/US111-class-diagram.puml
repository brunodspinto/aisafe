@startuml class-diagram-us111
skinparam shadowing false
skinparam classAttributeIconSize 0

package "Presentation" {
    class GenerateSimulationReportUI {
        +doShow() : boolean
    }
}

package "Application Layer" {
    class GenerateSimulationReportController <<UseCaseController>> {
        -authz : AuthorizationService
        -resultsReader : SimulationResultsReader
        -reportFormatter : OperationalReportFormatter
        -reportWriter : ReportWriter
        +generate() : GeneratedReport
    }

    interface SimulationResultsReader {
        +read(source : Path) : SimulationResults
    }
}

package "Domain Layer" {
    class Simulation <<entity, aggregate root>> {
        +buildReport(results : SimulationResults) : SimulationReport
        +status() : SimulationStatus
    }

    class SimulationReport <<entity>> {
        +totalFlights() : int
        +passed() : boolean
        +safetyViolations() : List<SafetyViolation>
        +executionStatuses() : List<FlightExecutionStatus>
    }

    class FlightExecutionStatus <<value object>>
    class SafetyViolation <<value object>>
    class SimulationResults <<value object>>
    enum SimulationStatus {
        PENDING
        RUNNING
        COMPLETED
        FAILED
    }
}

package "Infrastructure" {
    class TextSimulationResultsReader
}

package "Reporting Framework (US112, reused)" {
    class ReportData
    class OperationalReportFormatter
    class ReportWriter
}

GenerateSimulationReportUI ..> GenerateSimulationReportController : uses
GenerateSimulationReportController ..> SimulationResultsReader : reads results
GenerateSimulationReportController ..> Simulation : builds report on
GenerateSimulationReportController ..> ReportData : builds
GenerateSimulationReportController ..> OperationalReportFormatter : formats
GenerateSimulationReportController ..> ReportWriter : writes file
Simulation *-- SimulationReport : produces
Simulation --> SimulationStatus : has
SimulationReport *-- "0..*" SafetyViolation : records
SimulationReport *-- "0..*" FlightExecutionStatus : details
TextSimulationResultsReader ..|> SimulationResultsReader
SimulationResultsReader ..> SimulationResults : returns

@enduml
