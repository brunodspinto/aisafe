@startuml sd30-menu
skinparam shadowing false
autonumber

actor User as user
participant "MainMenu" as menu
participant "LogoutUI" as logoutUI
participant "AuthenticationContext\n(AISafe)" as authCtx
participant "AuthorizationService\n(EAPLI)" as authz

user -> menu : mainLoop()
activate menu

menu -> authz : session()
authz --> menu : Optional<UserSession>

menu -> authz : isAuthenticatedUserAuthorizedTo(ADMIN)
authz --> menu : boolean

alt user has ADMIN role
    menu -> user : show "Users >" submenu option
else other roles
    menu -> user : show only "My Account >" and "Exit"
end

user -> menu : select option

alt "My Account > Logout"
    menu -> logoutUI : show()
    activate logoutUI
    logoutUI -> authCtx : clear()
    authCtx -> authz : clearSession()
    authCtx --> logoutUI : session cleared
    logoutUI --> menu : return
    deactivate logoutUI
else "Users > Add User" (ADMIN only)
    menu -> user : open AddUserUI
end

deactivate menu

@enduml
