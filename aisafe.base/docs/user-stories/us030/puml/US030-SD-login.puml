@startuml sd30-login
skinparam shadowing false
autonumber

actor User as user
participant "AiSafeConsoleApp" as app
participant "LoginUI" as loginUI
participant "AuthenticationContext\n(AISafe)" as authCtx
participant "AuthenticationService\n(EAPLI)" as authSvc
participant "AuthzRegistry\n(EAPLI)" as registry

app -> loginUI : show()
activate loginUI

loginUI -> user : prompt username + password
user -> loginUI : username, password

loginUI -> authCtx : authenticate(username, password)
activate authCtx
authCtx -> registry : authenticationService()
registry --> authCtx : authSvc

authCtx -> authSvc : authenticate(username, password, null)
activate authSvc
authSvc --> authCtx : Optional<UserSession>
deactivate authSvc
authCtx --> loginUI : true
deactivate authCtx

loginUI --> app : true (login successful)

deactivate loginUI

@enduml
