@startuml US074_DomainModel

skinparam shadowing false
skinparam classAttributeIconSize 0

title Domain Model - US074 Deactivate a Flight Route

package "FlightRoute Aggregate" <<Rectangle>> {

    class FlightRoute <<entity, aggregate root>> {
        name : RouteName
        activeUntil : LocalDate
    }

    class RouteName <<value object, identity>> {
        name : String
    }

    enum FlightRouteStatus {
        ACTIVE
        INACTIVE
    }

    class AirportIATACode <<value object>> {
        iataCode : String
    }
}

package "Flight Aggregate" <<Rectangle>> {

    class Flight <<entity, aggregate root>> {
        flightDesignator
        departureDateTime
        scheduledArrival
    }
}

package "AirTransportCompany Aggregate" <<Rectangle>> {

    class AirTransportCompany <<entity, aggregate root>> {
        name : String
    }

    class IATACode <<value object, identity>> {
        code : String
    }
}

FlightRoute "1" *-- "1" RouteName            : "identified by >"
FlightRoute "1" *-- "1" FlightRouteStatus    : "has >"
FlightRoute "1" --> "1" AirportIATACode      : "origin >"
FlightRoute "1" --> "1" AirportIATACode      : "destination >"
FlightRoute "0..*" --> "1" AirTransportCompany : "operated by >"

AirTransportCompany "1" *-- "1" IATACode     : "identified by >"
AirTransportCompany "1" --> "0..*" FlightRoute : "operates >"

Flight "1" --> "1" FlightRoute               : "instance of >"

note right of FlightRoute
  activeUntil is set when the route
  is deactivated (AC074.1).
  Status transitions ACTIVE → INACTIVE.
end note

note right of Flight
  departureDateTime is checked against
  activeUntil to enforce AC074.3:
  no deactivation if planned flights exist
  on or after the chosen date.
end note

@enduml
