@startuml US085-SSD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

title US085 - Test/Validate Flight Plan (SSD)

autonumber
actor "Pilot" as PILOT
participant ":System" as SYS

activate PILOT
PILOT -> SYS : requests to test a flight plan
activate SYS
SYS --> PILOT : lists testable flight plans\n(VALIDATED and DSL-based)
deactivate SYS

PILOT -> SYS : selects a flight plan to test
activate SYS
SYS --> PILOT : test result\n(PASS -> status becomes TESTED, or FAIL + reason)
deactivate SYS
deactivate PILOT

@enduml
