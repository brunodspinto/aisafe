@startuml class-diagram-us078
skinparam shadowing false
skinparam classAttributeIconSize 0

package "Client Application" {
    class CollaboratorTcpClientApp {
        +main(args : String[]) : void
        -showMenu() : void
    }

    class CollaboratorTcpClient {
        -socket : Socket
        -in : BufferedReader
        -out : PrintWriter
        +CollaboratorTcpClient(host : String, port : int)
        +login(username : String, password : String) : boolean
        +listFleet() : List<String>
        +listFleetByModel(model : String) : List<String>
        +listFleetByMaker(maker : String) : List<String>
        +listFleetByCapacity(minSeats : String) : List<String>
        +listFleetByAge(fromYear : String) : List<String>
        +decommissionAircraft(registration : String) : String
        +listRoutes() : List<String>
        +createRoute(name : String, origin : String, dest : String) : String
        +deactivateRoute(routeName : String, date : String) : String
        +listPilots() : List<String>
        +removePilot(pilotId : String) : String
        +getLocalAddress() : InetAddress
        +getLocalPort() : int
        +exit() : void
        +close() : void
    }
}

package "aisafe.app.logging (shared)" {
    class RemoteAccessLogger {
        +RemoteAccessLogger(host : String, port : int, serviceId : String)
        +log(username : String, clientIp : String, clientPort : int, event : String) : void
    }
}

package "Server Application" {
    class AiSafeTcpServer {
        -serverSocket : ServerSocket
        +start(port : int) : void
    }

    class TcpClientDispatcher {
        -socket : Socket
        +TcpClientDispatcher(socket : Socket)
        +run() : void
    }

    class CollaboratorSessionHandler {
        -in : BufferedReader
        -out : PrintWriter
        +CollaboratorSessionHandler(in : BufferedReader, out : PrintWriter)
        +handle() : void
        -handleListFleet() : void
        -handleFleetByModel(cmd : String) : void
        -handleFleetByMaker(cmd : String) : void
        -handleFleetByCapacity(cmd : String) : void
        -handleFleetByAge(cmd : String) : void
        -handleDecommissionAircraft(cmd : String) : void
        -handleListRoutes() : void
        -handleCreateRoute(cmd : String) : void
        -handleDeactivateRoute(cmd : String) : void
        -handleListPilots() : void
        -handleRemovePilot(cmd : String) : void
    }
}

package "Application Layer (existing)" {
    class ListFleetController <<UseCaseController>>
    class DecommissionAircraftController <<UseCaseController>>
    class CreateFlightRouteController <<UseCaseController>>
    class DeactivateFlightRouteController <<UseCaseController>>
    class ListPilotRosterController <<UseCaseController>>
    class RemovePilotController <<UseCaseController>>
}

package "EAPLI Framework" <<frame>> {
    class AuthenticationContext {
        +authenticate(username : String, password : String) : boolean
        +hasRole(role : Role) : boolean
        +clear() : void
    }
}

package "Infrastructure" {
    class AiSafeRoles {
        {static} ATCC : Role
    }
}

CollaboratorTcpClientApp ..> CollaboratorTcpClient : uses
CollaboratorTcpClientApp ..> RemoteAccessLogger : logs login/logout/disconnect (UDP)
AiSafeTcpServer ..> TcpClientDispatcher : spawns
TcpClientDispatcher ..> AuthenticationContext : authenticates via
TcpClientDispatcher ..> AiSafeRoles : checks ATCC role
TcpClientDispatcher ..> CollaboratorSessionHandler : delegates to
CollaboratorSessionHandler ..> ListFleetController : LIST_FLEET (+ _BY_MODEL/MAKER/CAPACITY/AGE)
CollaboratorSessionHandler ..> DecommissionAircraftController : DECOMMISSION_AIRCRAFT
CollaboratorSessionHandler ..> CreateFlightRouteController : CREATE_ROUTE
CollaboratorSessionHandler ..> DeactivateFlightRouteController : LIST_ROUTES / DEACTIVATE_ROUTE
CollaboratorSessionHandler ..> ListPilotRosterController : LIST_PILOTS
CollaboratorSessionHandler ..> RemovePilotController : REMOVE_PILOT

@enduml
