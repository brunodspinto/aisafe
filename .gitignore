aisafe.base/simulation/*.exe
# object files in the simulation dir and its subdirs (e.g. tests/)
aisafe.base/simulation/**/*.o
# generated runtime outputs (report + live violation log)
aisafe.base/simulation/simulation_report.txt
aisafe.base/simulation/simulation_violation_log.txt
