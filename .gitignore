.idea/
*.iml

# Build outputs
bin/
**/target/

# Logs and temporary files
*.log
*.tmp
.weather-cp
aisafe.base/logs.txt
.vscode/settings.json
aisafe.base/db

# C simulation binaries and build artefacts
aisafe.base/simulation/simulation
aisafe.base/simulation/flight_simulator
aisafe.base/simulation/flight_tester
aisafe.base/simulation/test_validation
